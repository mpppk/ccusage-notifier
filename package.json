{
  "name": "ccusage-notifier",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "ccusage-notifier": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "check": "bun run index.ts --json",
    "watch": "bun run index.ts --watch 300 --calendar --calendar-api",
    "calendar": "bun run index.ts --calendar",
    "calendar:api": "bun run index.ts --calendar --calendar-api",
    "calendar:auth": "bun run index.ts --calendar-auth"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5 || ^7.0.0"
  }
}
